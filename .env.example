# Sewa Setu Configuration Template (.env.example)
# Copy to .env and customize for your environment.

# Departmental Officer Login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Application Secret Key (Flask session encryption)
SECRET_KEY=change-me-to-a-random-secret-key

# Internal Agent API Key (must match between portal and MCP servers)
AGENT_INTERNAL_KEY=change-me-to-a-long-random-internal-key

# Enabled blocks for AI assistant submissions (comma-separated subset of valid blocks)
# Valid blocks: Sonari, Rajapara, Dhemaji Pathar, Borgaon, Namti, Khelua
AGENT_ENABLED_BLOCKS=Sonari

# ---------------------------------------------------------------------------
# Deployment URL Settings
# ---------------------------------------------------------------------------
# LOCAL (HTTP via port 8080):
SITE_ADDRESS=:80
PUBLIC_BASE_URL=http://localhost:8080

# PRODUCTION (HTTPS with automatic TLS via Caddy):
# SITE_ADDRESS=sewasetu.example.in
# PUBLIC_BASE_URL=https://sewasetu.example.in
# NOTE: PUBLIC_BASE_URL must equal EXACTLY what a person types in the browser
# (correct scheme, host, port if non-standard, NO trailing slash).
